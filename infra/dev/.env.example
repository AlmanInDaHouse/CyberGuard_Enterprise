# CyberGuard — dev infra environment (DEV ONLY, NOT FOR PRODUCTION).
#
# Copy this file to .env in the same directory and adjust as needed.
# .env is git-ignored at the repo root (see .gitignore).
#
# All defaults are intended for local development. Production
# deployments use a different infra root (infra/prod/) with a
# different secrets pipeline; do not reuse these values.

# --- PostgreSQL (relational state, RBAC, cases, audit log; pgvector
# extension for forensic RAG and similarity).
# Host port intentionally non-standard (55432 instead of 5432) to
# avoid clashes with other local Postgres instances common on
# Windows dev machines.
CG_PG_PORT=15432
CG_PG_USER=cyberguard
CG_PG_PASSWORD=cyberguard_dev
CG_PG_DB=cyberguard

# --- ClickHouse (raw / normalized events, UEBA aggregations).
CG_CH_HTTP_PORT=8123
CG_CH_TCP_PORT=9000
CG_CH_USER=cyberguard
CG_CH_PASSWORD=cyberguard_dev
CG_CH_DB=cyberguard

# --- Redis (cache, sessions, rate limit, SOAR locks, anti-replay
# nonces — treated as ephemeral per ADR-0003 Rule 5).
# Host port intentionally non-standard (56379 instead of 6379) to
# avoid clashes with other local Redis instances common on Windows
# dev machines.
CG_REDIS_PORT=16379
CG_REDIS_PASSWORD=cyberguard_dev

# --- NATS JetStream (event bus, durable, replayable).
CG_NATS_CLIENT_PORT=4222
CG_NATS_MONITOR_PORT=8222

# --- MinIO (forensic artifacts, PDF / HTML reports, archived events;
# versioned and immutable per ADR-0003 Rule 3).
# Host ports 9001 / 9002 to avoid clash with ClickHouse TCP 9000.
CG_MINIO_API_PORT=9001
CG_MINIO_CONSOLE_PORT=9002
CG_MINIO_ROOT_USER=cyberguard
CG_MINIO_ROOT_PASSWORD=cyberguard_dev_minio_root

# --- API (human-facing auth-core / BFF, SPEC-008). Reuses the shared Postgres
# (users / audit_log) + Redis (sessions / rate-limit) above; no own backend.
# Host port intentionally non-standard (18081) to avoid clashes on dev machines.
# CG_API_DB_ENC_PASSPHRASE is the pgcrypto passphrase for users.totp_secret at
# rest — dev-only value; production uses a different secrets pipeline.
CG_API_PORT=18081
CG_API_DB_ENC_PASSPHRASE=cyberguard_dev_api_pass
CG_API_LOG_LEVEL=info
