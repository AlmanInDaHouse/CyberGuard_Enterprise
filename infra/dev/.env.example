# CyberGuard — dev infra environment (DEV ONLY, NOT FOR PRODUCTION).
#
# Copy this file to .env in the same directory and adjust as needed.
# .env is git-ignored at the repo root (see .gitignore).
#
# All defaults are intended for local development. Production
# deployments use a different infra root (infra/prod/) with a
# different secrets pipeline; do not reuse these values.

# --- PostgreSQL (relational state, RBAC, cases, audit log; pgvector
# extension for forensic RAG and similarity).
# Host port intentionally non-standard (15432 instead of 5432) to
# avoid clashes with other local Postgres instances common on
# Windows dev machines.
CG_PG_PORT=15432
CG_PG_USER=cyberguard
CG_PG_PASSWORD=cyberguard_dev
CG_PG_DB=cyberguard

# --- ClickHouse (raw / normalized events, UEBA aggregations).
CG_CH_HTTP_PORT=8123
CG_CH_TCP_PORT=9000
CG_CH_USER=cyberguard
CG_CH_PASSWORD=cyberguard_dev
CG_CH_DB=cyberguard

# --- The key-value store, Valkey, which the compose names redis (cache,
# sessions, rate limit, SOAR locks, anti-replay nonces — treated as
# ephemeral per ADR-0003 Rule 5; Valkey for Redis per ADR-0003 Amendment
# 2026-10-23). Host port intentionally non-standard (16379 instead of
# 6379) to avoid clashes with other local Redis or Valkey instances
# common on Windows dev machines.
CG_REDIS_PORT=16379
CG_REDIS_PASSWORD=cyberguard_dev

# --- API (human-facing auth-core / BFF, SPEC-008). Reuses the shared Postgres
# (users / audit_log) + Valkey (sessions / rate-limit) above; no own backend.
# Host port intentionally non-standard (18081) to avoid clashes on dev machines.
# CG_API_DB_ENC_PASSPHRASE is the pgcrypto passphrase for users.totp_secret at
# rest — dev-only value; production uses a different secrets pipeline.
# CG_API_FORENSIC_PASSPHRASE is the pgcrypto passphrase for the DEDICATED forensic
# Ed25519 signing key at rest (SPEC-012 §3 / ADR-0016 §5) — a DISTINCT secret from
# CG_API_DB_ENC_PASSPHRASE; dev-only value, production uses a different pipeline.
CG_API_PORT=18081
CG_API_DB_ENC_PASSPHRASE=cyberguard_dev_api_pass
CG_API_FORENSIC_PASSPHRASE=cyberguard_dev_forensic_pass
CG_API_LOG_LEVEL=info

# --- Production detection driver (ADR-0012 Amendment 2026-06-07). Poll interval
# in ms; 0 DISABLES the driver entirely (operator kill-switch). The rules dir
# defaults to the image-bundled path (Dockerfile COPY rules ./rules). Both have
# safe code defaults — these are the explicit, overridable operator surface.
CG_INGEST_DETECT_INTERVAL_MS=5000
CG_INGEST_DETECT_RULES_DIR=/app/rules/windows

# --- SOAR (SPEC-022 / ADR-0021). The playbooks directory; the image bundles the
# repository's playbooks/ there. Point it at an empty directory to turn SOAR off;
# a directory that does not exist leaves SOAR idle, logged at warn.
CG_INGEST_SOAR_PLAYBOOKS_DIR=/app/playbooks

# --- Incident email notification (SPEC-014 / ADR-0017, notify-only on incident
# CREATE). OPTIONAL and all-or-nothing: leave ALL SIX blank to disable notification
# cleanly (the default — there is no dev SMTP relay; detection still runs, only
# the email is skipped), or set ALL SIX to enable it. Transport is generic SMTP
# (Gmail is reached as `smtp.gmail.com` with an app password, NOT the Gmail API).
# These are an operator-set deployment contract; never bake real credentials here.
CG_INGEST_SMTP_HOST=
CG_INGEST_SMTP_PORT=
CG_INGEST_SMTP_USER=
CG_INGEST_SMTP_PASS=
CG_INGEST_SMTP_FROM=
CG_INGEST_NOTIFY_RECIPIENT=
