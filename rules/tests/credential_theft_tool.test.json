{
  "rule": "rule.credential_theft_tool",
  "description": "A credential-theft tool under its public name matches, in both path forms; a name that only contains a tool name, and lsass.exe itself, do not.",
  "cases": [
    {
      "name": "mimikatz.exe on the Desktop -> match",
      "event": {
        "Image": "C:\\Users\\alice\\Desktop\\mimikatz.exe",
        "ParentImage": "C:\\Windows\\System32\\cmd.exe"
      },
      "expected_match": true
    },
    {
      "name": "device form: Rubeus.exe in Downloads -> match",
      "event": {
        "Image": "\\Device\\HarddiskVolume3\\Users\\alice\\Downloads\\Rubeus.exe",
        "ParentImage": "\\Device\\HarddiskVolume3\\Windows\\System32\\cmd.exe"
      },
      "expected_match": true
    },
    {
      "name": "LaZagne.exe -> match",
      "event": {
        "Image": "C:\\Users\\Public\\LaZagne.exe",
        "ParentImage": null
      },
      "expected_match": true
    },
    {
      "name": "near miss: notmimikatz.exe (no path separator before the name) -> no match",
      "event": {
        "Image": "C:\\Users\\alice\\Desktop\\notmimikatz.exe",
        "ParentImage": "C:\\Windows\\explorer.exe"
      },
      "expected_match": false
    },
    {
      "name": "near miss: lsass.exe itself -> no match",
      "event": {
        "Image": "C:\\Windows\\System32\\lsass.exe",
        "ParentImage": "C:\\Windows\\System32\\wininit.exe"
      },
      "expected_match": false
    }
  ]
}
