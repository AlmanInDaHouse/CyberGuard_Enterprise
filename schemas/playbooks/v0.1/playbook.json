{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberguard.local/schemas/playbooks/v0.1/playbook.json",
  "title": "CyberGuard SOAR playbook v0.1",
  "description": "One declarative SOAR playbook (ADR-0021, SPEC-022 §Data contracts §1). The loader adds what JSON Schema cannot state: unique step ids, the closed placeholder set, and no live agent.isolate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "trust_sources", "trigger", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^pb_[a-z0-9_]{1,60}$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "trust_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["rule", "ml", "hybrid_only"] }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "when"],
      "properties": {
        "on": { "const": "incident.created" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["severity_id_gte"],
          "properties": {
            "severity_id_gte": { "type": "integer", "minimum": 0, "maximum": 6 }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "mode": { "enum": ["live", "dry_run"] },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "action"],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "action": { "const": "agent.isolate" },
            "mode": { "$ref": "#/$defs/mode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "action", "params"],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "action": { "const": "notify.email" },
            "mode": { "$ref": "#/$defs/mode" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subject", "body"],
              "properties": {
                "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
                "body": { "type": "string", "minLength": 1, "maxLength": 4000 }
              }
            }
          }
        }
      ]
    }
  }
}
