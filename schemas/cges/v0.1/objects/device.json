{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberguard.io/schemas/cges/v0.1/objects/device.json",
  "title": "OCSF Device object",
  "description": "OCSF Device object as defined in OCSF v1.3. Additional fields permitted for OCSF extension.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "hostname": { "type": "string", "minLength": 1 },
    "ip": { "type": "string" },
    "os": { "type": "string" },
    "type": { "type": "string" }
  },
  "required": ["hostname"],
  "examples": [
    {
      "hostname": "FIN-PC-014",
      "ip": "10.0.4.18",
      "os": "Windows 11 23H2",
      "type": "Desktop"
    }
  ]
}
