{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberguard.io/schemas/cges/v0.1/classes/incident.json",
  "title": "CGES — Incident",
  "description": "CyberGuard-specific Incident class (CGES extension, no OCSF equivalent). Assigned category_uid=10 and class_uid=10002 in the CyberGuard custom UID range. Groups one or more alerts within a correlation window. See ADR-0005 and ADR-0006.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "category_uid": { "const": 10 },
    "class_uid": { "const": 10002 },
    "cg_kind": { "const": "incident" },
    "activity_id": {
      "type": "integer",
      "enum": [0, 1, 2, 3, 4, 5, 6, 99],
      "description": "0=Unknown, 1=Created, 2=Acknowledged, 3=Investigating, 4=Contained, 5=Resolved, 6=False Positive, 99=Other."
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "investigating",
        "contained",
        "resolved",
        "false_positive"
      ]
    },
    "alert_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assigned_to": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "category_uid",
    "class_uid",
    "cg_kind",
    "activity_id",
    "incident_id",
    "title",
    "status",
    "alert_ids",
    "created_at",
    "updated_at"
  ]
}
