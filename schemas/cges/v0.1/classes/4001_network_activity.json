{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberguard.io/schemas/cges/v0.1/classes/4001_network_activity.json",
  "title": "OCSF 4001 — Network Activity",
  "description": "OCSF Network Activity class (category_uid=4 Network Activity). Inherits class semantics from OCSF v1.3.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "category_uid": { "const": 4 },
    "class_uid": { "const": 4001 },
    "activity_id": {
      "type": "integer",
      "enum": [0, 1, 2, 3, 4, 5, 6, 7, 99],
      "description": "0=Unknown, 1=Open, 2=Close, 3=Reset, 4=Fail, 5=Refuse, 6=Traffic, 7=Listen, 99=Other."
    },
    "src_endpoint": {
      "$ref": "../objects/network_endpoint.json"
    },
    "dst_endpoint": {
      "$ref": "../objects/network_endpoint.json"
    },
    "connection_info": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "protocol_name": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["inbound", "outbound", "lateral", "unknown"]
        },
        "protocol_num": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    }
  },
  "required": ["category_uid", "class_uid", "activity_id", "src_endpoint", "dst_endpoint"]
}
