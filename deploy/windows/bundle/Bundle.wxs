<!--
  The agent's setup, cyberguard-agent-<version>-x64-setup.exe (SPEC-024 §Data contracts §1, its
  Amendment 2026-11-09, items 1 and 2, and its Amendment 2026-11-12 (second), point 1): WiX's
  Burn engine, its code unmodified and its version resource the setup's (the Amendment
  2026-11-14, point 9), and WiX's unmodified standard bootstrapper application, with the
  project's own theme (the Amendment 2026-11-12 (second), point 8). Its chain runs cg-setup preflight, the MSI with the chain's
  property, a vital rollback boundary, then cg-setup configure; Burn rolls preflight back with
  cg-setup reverse. Burn carries no secret: the bundle variables name a file and the migration's
  choices, never the token. The setup has no condition or search of its own: preflight decides.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!-- One upgrade family of setups across releases, its version the release version. The
       publisher and the copyright are provisional (SPEC-024 Amendment 2026-11-12, point 5). The
       binder writes this version resource over the engine's, so the copyright keeps WiX's line
       as burn.exe states it (the Amendment 2026-11-14, point 10); the window's own text is the
       theme's. -->
  <Bundle Name="CyberGuard Agent" Manufacturer="CyberGuard"
          Copyright="Copyright (c) CyberGuard. Burn engine: Copyright (c) .NET Foundation and contributors. All rights reserved."
          Version="$(var.ProductVersion)" UpgradeCode="B3D1FE6C-5F20-4E58-9B7A-3A7C8E1D4F10">
    <!-- The standard bootstrapper application with the project's theme: no licence to accept (an
         empty LicenseUrl hides it), no image, no cancellation while the chain applies, and a
         failure page that names Burn's log (theme/). -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
          ThemeFile="$(sys.SOURCEFILEDIR)theme\CyberGuardTheme.xml"
          LocalizationFile="$(sys.SOURCEFILEDIR)theme\CyberGuardTheme.wxl"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!-- The unattended route's inputs (the Amendment 2026-11-09, item 2), none persisted: a
         repair or an uninstallation from the registered setup passes none. -->
    <Variable Name="CG_BOOTSTRAP" Type="string" Value="" bal:Overridable="yes" />
    <Variable Name="CG_MIGRATE_LEGACY" Type="string" Value="" bal:Overridable="yes" />
    <Variable Name="CG_TRUST_ANCHORS" Type="string" Value="" bal:Overridable="yes" />

    <Chain>
      <!-- Each step's cache folder is this build's own (BuildId): a second build of the version
           removes the first, whose uncache would otherwise delete the folder of the same name.
           Detected absent, so that it runs on every install, repair and upgrade and on
           uninstall not at all; Burn's rollback of it is the reversal (point 2). Preflight is
           told the setup's window, WixBundleUILevel, which -quiet and -passive lower and a
           variable on the command line cannot set: the wizard shows only with the full window
           (the Amendment 2026-11-13, point 1). -->
      <ExePackage Id="Preflight" CacheId="cg-setup-preflight-$(var.ProductVersion)-$(var.BuildId)" PerMachine="yes"
                  Vital="yes" DetectCondition="1 = 0"
                  SourceFile="$(var.SetupExe)" Name="preflight\cg-setup.exe"
                  InstallArguments="preflight --bootstrap=&quot;[CG_BOOTSTRAP]&quot; --migrate-legacy=&quot;[CG_MIGRATE_LEGACY]&quot; --trust-anchors=&quot;[CG_TRUST_ANCHORS]&quot; --ui=&quot;[WixBundleUILevel]&quot;"
                  UninstallArguments="reverse" />
      <!-- The MSI, admitted by its launch conditions with the chain's property (the Amendment
           2026-11-12, point 1). -->
      <MsiPackage Id="Agent" SourceFile="$(var.Msi)" Vital="yes">
        <MsiProperty Name="CG_SETUP_CHAIN" Value="1" />
      </MsiPackage>
      <RollbackBoundary Id="Committed" Vital="yes" />
      <!-- Permanent and detected by no condition: it runs on every install, repair and upgrade,
           and nothing rolls it back or uninstalls it. -->
      <ExePackage Id="Configure" CacheId="cg-setup-configure-$(var.ProductVersion)-$(var.BuildId)" PerMachine="yes"
                  Vital="yes" Permanent="yes" DetectCondition=""
                  SourceFile="$(var.SetupExe)" Name="configure\cg-setup.exe"
                  InstallArguments="configure --migrate-legacy=&quot;[CG_MIGRATE_LEGACY]&quot; --trust-anchors=&quot;[CG_TRUST_ANCHORS]&quot;" />
    </Chain>
  </Bundle>
</Wix>
