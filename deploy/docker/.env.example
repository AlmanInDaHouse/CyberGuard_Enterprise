# CyberGuard's bundle variables (SPEC-023 §Data contracts §3).
# setup.sh copies this file to .env (mode 0600) on its first run. Set the two hostnames and
# the TLS mode, then run setup.sh again: it fills every empty secret below and adds any
# variable a newer bundle brings. The compose and the bundle's scripts read .env.

# The DNS name users reach the dashboard by: the proxy's site address. Required.
CG_DASHBOARD_HOSTNAME=
# provided: the proxy serves tls/dashboard.crt and tls/dashboard.key.
# internal: the proxy issues a certificate from its own CA, for an evaluation.
CG_TLS_MODE=provided
# Comma-separated DNS names and IP addresses the agents reach the server by: the server
# certificate's names. Required.
CG_AGENT_SERVER_NAMES=

# The host address the published ports bind, and the ports.
CG_BIND_ADDRESS=0.0.0.0
CG_HTTPS_PORT=443
CG_HTTP_PORT=80
CG_ENROLL_PORT=8444
CG_HEARTBEAT_PORT=8443

# The internal network between the dashboard and the api: its subnet, the range Docker
# hands out in it, and the dashboard's address, inside the subnet and outside the range.
# Change them before the first start when a network the host routes to overlaps the
# subnet, or when a second installation runs on the same host; on an installed stack a
# change takes docker compose down, then docker compose up -d --wait.
CG_APP_SUBNET=10.254.254.0/28
CG_APP_IP_RANGE=10.254.254.8/29
CG_DASHBOARD_APP_ADDRESS=10.254.254.2

# The SMTP relay for incident notifications: all six or none (SPEC-014).
CG_SMTP_HOST=
CG_SMTP_PORT=
CG_SMTP_USER=
CG_SMTP_PASS=
CG_SMTP_FROM=
CG_NOTIFY_RECIPIENT=
# The name of a PEM file in relay/ holding the relay's private CA, when it has one.
CG_SMTP_CA_FILE=

# The host directory backup.sh writes its encrypted files to.
CG_BACKUP_DIR=backups

# Days each class of events and the heartbeats are kept, from 7 to 3650.
CG_RETENTION_PROCESS_DAYS=365
CG_RETENTION_NETWORK_DAYS=365
CG_RETENTION_LOGON_DAYS=365
CG_RETENTION_HEARTBEAT_DAYS=30

# A session's idle lifetime (5 to 480 minutes) and its cap (1 to 24 hours).
CG_SESSION_IDLE_MINUTES=480
CG_SESSION_MAX_HOURS=24

# The detection driver's poll interval; 0 turns detection off.
CG_DETECT_INTERVAL_MS=5000
# The directory, inside ingest's container, SOAR reads its playbooks from. Empty: the
# image's playbooks/. /app/playbooks-none leaves SOAR idle.
CG_SOAR_PLAYBOOKS_DIR=

# Ingest's and the api's log level: fatal, error, warn, info, debug, trace or silent.
CG_LOG_LEVEL=info

# The secrets setup.sh generates: 32 random bytes in hexadecimal each, filled when empty and
# kept once set. This file is the deployment's master secret: keep a copy of it apart from
# the backups.
CG_PG_SUPERUSER_PASSWORD=
CG_PG_INGEST_OWNER_PASSWORD=
CG_PG_INGEST_PASSWORD=
CG_PG_API_OWNER_PASSWORD=
CG_PG_API_PASSWORD=
CG_CH_ADMIN_PASSWORD=
CG_CH_INGEST_PASSWORD=
CG_CH_API_PASSWORD=
CG_REDIS_INGEST_PASSWORD=
CG_REDIS_API_PASSWORD=
CG_INGEST_CA_PASSPHRASE=
CG_API_DB_ENC_PASSPHRASE=
CG_API_FORENSIC_PASSPHRASE=
CG_BACKUP_PASSPHRASE=
