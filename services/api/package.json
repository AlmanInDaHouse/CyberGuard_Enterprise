{
  "name": "@cyberguard/api",
  "version": "0.1.0",
  "private": true,
  "description": "CyberGuard human-facing API / BFF — auth-core (SPEC-008).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "cg-api-create-user": "./dist/cli/create-user.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "create-user": "tsx src/cli/create-user.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@clickhouse/client": "^1.7.0",
    "@fastify/cookie": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.5.1",
    "canonicalize": "^2.0.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "kysely": "^0.27.5",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unpdf": "^1.6.2",
    "vitest": "^2.1.8"
  }
}
